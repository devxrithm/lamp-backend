

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model onlineRound {
  teamId              Int    @id
  teamName            String @unique
  presentation        Int
  innovationMarks     Int
  technicalComplexity Int
  marketFeasibility   Int
  futureScope         Int
  totalMarks          Int
  uploadedBy          String
}

model offlineMentorRound {
  uploadedBy          String
  teamName            String @unique
  presentation        Int
  innovationMarks     Int
  technicalComplexity Int
  marketFeasibility   Int
  futureScope         Int
  totalMarks          Int
  round               Int
}

model offlineJuryRound {
  teamId              Int    @id
  uploadedBy          String
  teamName            String @unique
  presentation        Int
  innovationMarks     Int
  technicalComplexity Int
  marketFeasibility   Int
  futureScope         Int
  totalMarks          Int
}
