

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  password     String
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model onlineRound {
  id                  Int    @default(autoincrement())
  teamId              Int    @id
  teamName            String @unique
  presentation        Int
  innovationMarks     Int
  technicalComplexity Int
  marketFeasibility   Int
  futureScope         Int
  totalMarks          Int
}

model offlineMentorRound {
  id                  Int    @id @default(autoincrement())
  uploadedBy          String
  teamName            String @unique
  presentation        Int
  innovationMarks     Int
  technicalComplexity Int
  marketFeasibility   Int
  futureScope         Int
  totalMarks          Int
  round               Int
}

model offlineJuryRound {
  id                  Int    @id @default(autoincrement())
  teamId              Int
  uploadedBy          String
  teamName            String @unique
  presentation        Int
  innovationMarks     Int
  technicalComplexity Int
  marketFeasibility   Int
  futureScope         Int
  totalMarks          Int
}
