

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model mentorTeams {
  teamId              Int    @id
  teamName            String @unique
  presentation        Int
  innovationMarks     Int
  technicalComplexity Int
  marketFeasibility   Int
  futureScope         Int
  totalMarks          Int
}
